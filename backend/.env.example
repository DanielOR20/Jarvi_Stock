# =============================================================================
# 1. CRM, SERVIDOR, BASE DE DATOS Y MOTOR IA (Equipo Backend Core)
# =============================================================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Multi-Tenant (Requerido en produccion / Render; opcional en pruebas locales con fallback en memoria)
DATABASE_URL=

# Autenticacion CRM y comunicacion interna del motor
JWT_SECRET=cambiar_por_secreto_seguro_min_32_caracteres
INTERNAL_ENGINE_KEY=cambiar_por_clave_interna_engine

# Motor IA (opcional para enriquecer LLM; el enrutador base funciona sin clave externa)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Almacenamiento publico de imagenes y expiracion HITL
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/uploads
PENDING_ACTION_TTL_HOURS=24

# =============================================================================
# 2. META WHATSAPP BUSINESS CLOUD API (Completar por Desarrollador Meta)
# =============================================================================
# Token arbitrario configurado en Meta for Developers > Webhooks (para GET hub.verify_token)
WHATSAPP_VERIFY_TOKEN=jarvi_stock_verify_token_local

# Token permanente de System User con permisos whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=

# Identificador numerico del numero de telefono en Meta WhatsApp API Setup
WHATSAPP_PHONE_NUMBER_ID=

# App Secret del dashboard de Meta App (Settings > Basic) para validar X-Hub-Signature-256
# Obligatorio: sin el, el webhook rechaza todas las peticiones.
WHATSAPP_APP_SECRET=

# Solo pruebas locales sin App Secret: true acepta webhooks sin firma.
# Se ignora si NODE_ENV=production o si hay App Secret. Nunca activarlo en Render.
WEBHOOK_ALLOW_UNSIGNED=false

# Opcionales recomendados
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WABA_ID=
WHATSAPP_DRY_RUN=false

# Numero visible del numero compartido (con codigo de pais, ej. 50612345678).
# Se usa para los enlaces wa.me que la fabrica entrega a cada negocio.
WHATSAPP_DISPLAY_PHONE=

# URL publica del servicio (ej. https://jarvi-stock.onrender.com). Meta descarga
# desde aqui la imagen del QR; sin ella solo se envia el enlace.
PUBLIC_BASE_URL=
